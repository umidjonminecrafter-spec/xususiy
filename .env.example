# ==============================================================================
# SmartTalim Backend Environment Configuration Template
# ==============================================================================

# --- Core Django Settings ---
SECRET_KEY=django-insecure-change-this-in-production-key-123456
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*
PORT=8000

# --- Database Configuration ---
# Default SQLite: sqlite:///db.sqlite3
# PostgreSQL example: postgres://postgres:password@localhost:5432/smarttalim_db
DATABASE_URL=sqlite:///db.sqlite3
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smarttalim_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- CORS & Security Settings ---
CORS_ALLOW_ALL_ORIGINS=True
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# --- External Services & Integrations ---
# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# SMS Provider (Eskiz.uz)
ESKIZ_EMAIL=your_email@example.com
ESKIZ_PASSWORD=your_eskiz_password

# AI & LLM Services
GEMINI_API_KEY=
OPENAI_API_KEY=
